{% if entry.title == 'Awards and Honours' %}
  <ul class="cv-awards-list">
    {% for content in entry.contents %}
      <li>{{ content }}</li>
    {% endfor %}
  </ul>
{% else %}
  <div class="cv-simple-list">
    {% for content in entry.contents %}
      <div class="cv-simple-item">{{ content }}</div>
    {% endfor %}
  </div>
{% endif %}
